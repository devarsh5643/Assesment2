Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep real assets and files available.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Send clean application paths to the PHP router.
    RewriteRule ^(.+?)/?$ index.php?page=$1 [L,QSA]
</IfModule>

<FilesMatch "\.(db|sqlite|sqlite3|db-shm|db-wal)$">
    Require all denied
</FilesMatch>
