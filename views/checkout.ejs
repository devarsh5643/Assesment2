<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head>
<body>
<header class="site-header"><div class="container nav-wrap"><a class="brand" href="/" aria-label="Adelaide Artisan Bakery home"><span class="brand-mark">AAB</span><span>Adelaide<br><em>Artisan Bakery</em></span></a><nav aria-label="Primary navigation"><a href="/menu">Menu</a><a href="/checkout" class="button button-small">Cart</a></nav></div></header>
<main>
<section class="checkout-section container"><div class="section-heading"><p class="eyebrow">Review & place order</p><h1>Your order</h1><p class="section-intro">Review your items and provide delivery details to complete your order.</p></div><% if (errors && errors.length) { %><div class="notice error" role="alert" aria-live="polite"><strong>Please check the following:</strong><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><div class="checkout-grid"><section class="checkout-cart"><h2>Cart items</h2><% if (cart && cart.length > 0) { %><div class="cart-items"><% let subtotal = 0; cart.forEach(item => { const itemTotal = item.price_cents * item.quantity; subtotal += itemTotal; %><div class="cart-item"><div class="cart-item-details"><h4><%= item.name %></h4><p class="cart-item-meta"><%= item.category %> · Qty: <%= item.quantity %></p></div><div class="cart-item-price"><strong>$<%= (itemTotal / 100).toFixed(2) %></strong> <a href="/cart/remove/<%= item.id %>" class="text-button">Remove</a></div></div><% }) %></div><div class="cart-summary"><div class="summary-row"><span>Subtotal</span><strong>$<%= (subtotal / 100).toFixed(2) %></strong></div><div class="summary-row"><span>Delivery</span><strong>Free</strong></div><div class="summary-row total"><span>Total</span><strong>$<%= (total / 100).toFixed(2) %></strong></div></div><% } else { %><p class="empty-state">Your cart is empty. <a href="/menu">Browse the menu</a> to add items.</p><% } %></section><section class="checkout-form"><h2>Delivery details</h2><form action="/checkout" method="post" novalidate><div class="field-row"><div class="field"><label for="customerName">Your name</label><input id="customerName" name="customerName" value="<%= formData?.customerName || '' %>" required></div><div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" value="<%= formData?.email || '' %>" required></div></div><div class="field-row"><div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" value="<%= formData?.phone || '' %>" required></div></div><div class="field"><label for="address">Delivery address</label><textarea id="address" name="address" rows="3" required><%= formData?.address || '' %></textarea></div><div class="field"><label for="message">Special requests (optional)</label><textarea id="message" name="message" rows="3"><%= formData?.message || '' %></textarea></div><button class="button" type="submit" <% if (!cart || cart.length === 0) { %>disabled<% } %>>Place order <span aria-hidden="true">→</span></button></form></section></div></section>
</main>
<footer class="site-footer"><div class="container"><span>© <%= new Date().getFullYear() %> Adelaide Artisan Bakery</span><div class="footer-contact"><a href="mailto:pateldevarsh1010@gmail.com">Email: pateldevarsh1010@gmail.com</a> · <span>Call: 0493875729</span></div><a href="/admin">Admin</a></div></footer>
</body></html>
