<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head><body><header class="site-header"><div class="container nav-wrap"><a class="brand" href="/">Adelaide <em>Artisan Bakery</em></a><a href="/">View public site</a></div></header><main class="admin-page container"><div class="section-heading"><div><p class="eyebrow">Private workspace</p><h1>Bakery admin</h1></div><p class="section-intro">Manage the public counter and review incoming enquiries.</p></div><section class="admin-section"><h2>Add a product</h2><form class="admin-form" action="/admin/products" method="post"><input type="hidden" name="adminToken" value="<%= token %>"><label for="new-name">Name</label><input id="new-name" name="name" required><label for="new-description">Description</label><textarea id="new-description" name="description" rows="3" required></textarea><div class="field-row"><div><label for="new-price">Price (AUD)</label><input id="new-price" name="price" type="number" min="0" step="0.01" required></div><div><label for="new-category">Category</label><select id="new-category" name="category" required><% categories.forEach(category => { %><option><%= category %></option><% }) %></select></div></div><label for="new-image">Image URL</label><input id="new-image" name="imageUrl" type="url" required><button class="button" type="submit">Add product</button></form></section><section class="admin-section"><h2>Products <span class="count"><%= products.length %></span></h2><div class="admin-list"><% products.forEach(product => { %><form class="admin-product" action="/admin/products/<%= product.id %>/update" method="post"><input type="hidden" name="adminToken" value="<%= token %>"><div class="admin-product-head"><strong>#<%= product.id %> · <%= product.name %></strong><button class="text-button danger" formaction="/admin/products/<%= product.id %>/delete" formmethod="post" type="submit">Delete</button></div><label for="name-<%= product.id %>">Name</label><input id="name-<%= product.id %>" name="name" value="<%= product.name %>" required><label for="description-<%= product.id %>">Description</label><textarea id="description-<%= product.id %>" name="description" rows="2" required><%= product.description %></textarea><div class="field-row"><div><label for="price-<%= product.id %>">Price (AUD)</label><input id="price-<%= product.id %>" name="price" type="number" min="0" step="0.01" value="<%= product.price %>" required></div><div><label for="category-<%= product.id %>">Category</label><select id="category-<%= product.id %>" name="category"><% categories.forEach(category => { %><option <%= product.category === category ? 'selected' : '' %>><%= category %></option><% }) %></select></div></div><label for="image-<%= product.id %>">Image URL</label><input id="image-<%= product.id %>" name="imageUrl" type="url" value="<%= product.image_url %>" required><button class="button button-small" type="submit">Save changes</button></form><% }) %></div></section><section class="admin-section"><h2>Enquiries <span class="count"><%= enquiries.length %></span></h2><div class="enquiries"><% enquiries.forEach(enquiry => { %><article class="enquiry-item"><div><strong><%= enquiry.customer_name %></strong><span><%= enquiry.enquiry_type %> · <%= enquiry.email %> · <%= enquiry.phone %></span></div><p><%= enquiry.message %></p></article><% }) %></div></section></main></body></html>
